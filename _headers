# Netlify headers for app.sprinkflow.studio (the PWA).
# Closes the "no security headers on GitHub Pages" gap from the security audit.
# NOTE: no CSP yet — the tools/games use inline scripts + several origins; adding a
# CSP deserves its own tested pass, not a rider on a host migration.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000

# The service worker must never be cached — it's the update mechanism itself.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Content-Type: application/manifest+json
